<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
{%- if isBuild %}
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'">
{%- endif %}
  <meta name="referrer" content="strict-origin-when-cross-origin">
  <meta name="viewport" content="width=device-width, initial-scale=1">
{%- if robots %}
  <meta name="robots" content="{{ robots }}">
{%- endif %}
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
{%- if not robots %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- endif %}
  <meta property="og:type" content="website">
{%- if not robots %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- endif %}
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:image" content="{{ site.url }}/assets/og.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="{{ site.themeColor }}">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/site.css' | v }}">
  <script src="{{ '/assets/site.js' | v }}" defer></script>
{%- if page.url == "/" %}
  <script type="application/ld+json">
  {{ structuredData | dump | safe }}
  </script>
{%- endif %}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="/" aria-label="Alloy Catalog home">
        <img src="/brand/lockup-on-dark.svg" alt="Alloy Catalog" width="172" height="30">
      </a>
      <nav class="nav-links" aria-label="Main">
{%- for item in site.nav %}
        <a href="{{ "" if page.url == "/" else "/" }}{{ item.href }}">{{ item.label }}</a>
{%- endfor %}
      </nav>
      <details class="menu">
        <summary>Menu</summary>
        <nav aria-label="Main menu">
{%- for item in site.nav %}
          <a href="{{ "" if page.url == "/" else "/" }}{{ item.href }}">{{ item.label }}</a>
{%- endfor %}
        </nav>
      </details>
      <a class="btn btn-primary btn-sm" href="{{ derived.demoHref }}">Book a demo</a>
    </div>
  </header>

  <main id="main">
{{ content | safe }}  </main>

  <footer class="footer">
    <div class="wrap footer-inner">
      <img src="/brand/lockup-on-dark.svg" alt="Alloy Catalog" width="138" height="24">
      <p>A product by <a href="https://flid.ai">Flid</a>. © {{ derived.year }} Flid.</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p><a href="/privacy/">Privacy</a> · <a href="/company/">Company</a></p>
    </div>
  </footer>
</body>
</html>
